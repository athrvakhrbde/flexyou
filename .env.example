# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma — use Transaction pooler (port 6543) with ?pgbouncer=true
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for migrations (port 5432)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Local: http://localhost:3001 — Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google OAuth (local Supabase reads these via supabase/config.toml)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deferred (Pro monetization)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
